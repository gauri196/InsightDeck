# ==============================================================================
# InsightDeck Environment Configuration Example
# ==============================================================================
# IMPORTANT: Use placeholders only. NEVER commit real secrets or credentials.
# Duplicate this file to .env (or configure backend/.env and frontend/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
PORT=8000
BACKEND_URL=http://localhost:8000

# Firebase Admin SDK Configuration
# Option A: Local service account JSON path (must be outside git or ignored)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-service-account.json

# Option B: Google Application Credentials environment variable
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Option C: Firebase Project ID (for cloud environments with ambient credentials)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite / React)
# ------------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000

# Firebase Web App Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
