# ==============================================================================
# InsightDeck Git Ignore Configuration
# ==============================================================================

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example
!frontend/.env.example
!backend/.env.example
*service-account*.json
*service_account*.json
*credentials*.json
*.pem
*.key

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Node & Frontend Build Artifacts
node_modules/
dist/
dist-ssr/
frontend/node_modules/
frontend/dist/
*.local

# Logs
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User Data & Generated Outputs
*.xlsx
*.pptx
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
